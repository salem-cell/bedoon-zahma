// الإنتاج: لا Mocks إطلاقًا. المفاتيح من Secrets.xcconfig أو من متغيرات CI.
#include? "Secrets.xcconfig"

BZ_USE_MOCKS = 0
// تنبيه: في xcconfig يبدأ // تعليقًا، لذا نكتب الرابط بصيغة $() لكسر الشرطتين
BZ_BACKEND_URL = https:/$()/bedoon-zahma-backend.vercel.app

// مزوّد البيانات: tomtom (مجاني، MapKit) أو google
BZ_MAPS_PROVIDER = google
// طبقة العرض: mapkit (Apple + إرشاد ذاتي) أو google (Maps SDK + Navigation SDK بمفتاح iOS)
BZ_MAP_RENDERER = mapkit
