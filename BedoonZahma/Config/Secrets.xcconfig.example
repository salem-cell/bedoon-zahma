// انسخ هذا الملف إلى Secrets.xcconfig (مُستثنى من git) واملأ القيم.
//
// مفتاح Maps/Navigation SDK لـ iOS — يجب تقييده في Google Cloud Console بـ:
//   Application restrictions: iOS apps → Bundle ID: sa.bedoonzahma.app
//   API restrictions: Maps SDK for iOS, Navigation SDK for iOS فقط.
// لا تُفعّل عليه Places API أو Routes API — تلك تُستدعى من الخادم بمفتاح خادمي منفصل.
GOOGLE_MAPS_IOS_KEY = AIza...

// مفتاح التطبيق للتحقق مع الخادم الخلفي (نفس قيمة APP_KEYS في backend/.env).
BZ_APP_KEY = change-me

// فريق Apple Developer للتوقيع.
BZ_TEAM_ID = ABCDE12345
