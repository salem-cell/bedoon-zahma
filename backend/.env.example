# انسخ إلى .env (غير مُتتبَّع). لا تضع المفاتيح في الكود أو في التطبيق.
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# مفتاح Google خادمي (Google Cloud Console):
#   Application restrictions: IP addresses (عناوين الخادم)
#   API restrictions: Routes API, Places API (New) فقط
GOOGLE_SERVER_API_KEY=

# مفاتيح التطبيق المقبولة (نفس قيمة BZ_APP_KEY في Config/Secrets.xcconfig). مفصولة بفواصل.
APP_KEYS=change-me

# للتطوير المحلي فقط
ALLOW_NO_APP_KEY=false
RATE_LIMIT_PER_MIN=120
DEFAULT_REGION_CODE=SA

# اختياري: ملف JSON يعدّل Remote Config (الأوزان، العتبات، الأعلام) بلا إصدار جديد
# CONFIG_OVERRIDES_PATH=./config.overrides.json

# اختياري: أسعار SKU التقديرية (USD/1000) لعرض التكلفة في /metrics — خذ القيم من جدول أسعار Google الحالي
# SKU_PRICES_JSON={"routes.compute.advanced":10,"routes.matrix.advanced":10,"places.nearby.enterprise_atmosphere":40,"places.details.enterprise_atmosphere":25,"places.autocomplete.session":2.83,"places.photo":7}
